<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="page" fx:id="ordersPage"
      fx:controller="bureau.fx.controller.OrdersController"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Заказы на перевод" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="Добавить" onAction="#add"/>
        <Button fx:id="editButton" text="Изменить" onAction="#edit"/>
        <Button fx:id="statusButton" text="Статус" onAction="#changeStatus"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#delete"/>
        <Button fx:id="refreshButton" text="Обновить" onAction="#refresh"/>
    </HBox>
    <VBox fx:id="filtersBox" spacing="12">
        <VBox spacing="6">
            <Label text="Поиск по названию и описанию"/>
            <HBox spacing="12">
                <TextField fx:id="searchField" promptText="Введите часть названия или описания"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="resetButton" text="Сбросить" onAction="#resetFilters"/>
            </HBox>
        </VBox>
        <HBox spacing="12">
            <VBox spacing="6" prefWidth="200" minWidth="160" HBox.hgrow="ALWAYS">
                <Label text="Статус"/>
                <ComboBox fx:id="statusFilter" maxWidth="Infinity" onAction="#applyFilters"/>
            </VBox>
            <VBox spacing="6" prefWidth="360" minWidth="200" HBox.hgrow="ALWAYS">
                <Label text="Клиент"/>
                <ComboBox fx:id="clientFilter" maxWidth="Infinity" onAction="#applyFilters"/>
            </VBox>
            <VBox spacing="6" prefWidth="300" minWidth="230" HBox.hgrow="ALWAYS">
                <Label text="Сортировка"/>
                <ComboBox fx:id="sortBox" maxWidth="Infinity" onAction="#applyFilters"/>
            </VBox>
        </HBox>
    </VBox>
    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Название" prefWidth="230" minWidth="150"/>
            <TableColumn fx:id="clientColumn" text="Клиент" prefWidth="180" minWidth="130"/>
            <TableColumn fx:id="sourceLanguageColumn" text="Исходный язык" prefWidth="130"/>
            <TableColumn fx:id="targetLanguageColumn" text="Язык перевода" prefWidth="135"/>
            <TableColumn fx:id="wordCountColumn" text="Слов" prefWidth="70"/>
            <TableColumn fx:id="priceColumn" text="Стоимость" prefWidth="140"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="130"/>
            <TableColumn fx:id="deadlineColumn" text="Срок" prefWidth="110"/>
            <TableColumn fx:id="createdAtColumn" text="Дата создания" prefWidth="170"/>
        </columns>
    </TableView>
    <VBox spacing="6">
        <Label text="Описание выбранного заказа"/>
        <TextArea fx:id="descriptionArea" editable="false" wrapText="true" prefRowCount="2"/>
    </VBox>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="messageLabel" styleClass="subtitle" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="exportButton" text="Экспорт Excel" onAction="#exportOrders"/>
    </HBox>
</VBox>
