<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" prefWidth="480" styleClass="page"
      fx:controller="bureau.fx.controller.ClientFormController"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox fx:id="fieldsBox" spacing="14">
        <VBox spacing="6">
            <Label text="ФИО / название *"/>
            <TextField fx:id="nameField" promptText="До 64 символов"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Почта *"/>
            <TextField fx:id="emailField" promptText="name@example.com, до 64 символов"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Телефон"/>
            <TextField fx:id="phoneField" promptText="Необязательное поле, до 30 символов"/>
        </VBox>
    </VBox>
    <Label text="* — обязательные поля" styleClass="subtitle"/>
    <Label fx:id="messageLabel" wrapText="true" styleClass="subtitle"/>
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="cancelButton" text="Отмена" cancelButton="true" onAction="#close"/>
        <Button fx:id="saveButton" text="Сохранить" defaultButton="true" onAction="#save"/>
    </HBox>
</VBox>
