<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="page" fx:id="clientsPage"
      fx:controller="bureau.fx.controller.ClientsController"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Клиенты" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="Добавить" onAction="#add"/>
        <Button fx:id="editButton" text="Изменить" onAction="#edit"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#delete"/>
        <Button fx:id="refreshButton" text="Обновить" onAction="#refresh"/>
    </HBox>
    <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="ФИО / название" prefWidth="360" minWidth="160"/>
            <TableColumn fx:id="emailColumn" text="Почта" prefWidth="360" minWidth="160"/>
            <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="260" minWidth="150"/>
        </columns>
    </TableView>
    <Label fx:id="messageLabel" styleClass="subtitle"/>
</VBox>
