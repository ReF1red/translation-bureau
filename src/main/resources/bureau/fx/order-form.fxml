<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" prefWidth="640" styleClass="page"
      fx:controller="bureau.fx.controller.OrderFormController"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox fx:id="fieldsBox" spacing="12">
        <VBox spacing="6">
            <Label text="Клиент *"/>
            <ComboBox fx:id="clientBox" promptText="Выберите клиента" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Название заказа *"/>
            <TextField fx:id="titleField" promptText="До 200 символов"/>
        </VBox>
        <GridPane hgap="16" vgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <children>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Исходный язык *"/>
                    <TextField fx:id="sourceLanguageField" promptText="Например, русский"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Язык перевода *"/>
                    <TextField fx:id="targetLanguageField" promptText="Например, английский"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Количество слов *"/>
                    <TextField fx:id="wordCountField" promptText="Например, 1200"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Стоимость, руб. *"/>
                    <TextField fx:id="priceField" promptText="Например, 1500,50"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Срок выполнения *"/>
                    <DatePicker fx:id="deadlinePicker" editable="false" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Статус"/>
                    <Label fx:id="statusLabel" styleClass="order-status"/>
                </VBox>
            </children>
        </GridPane>
        <VBox spacing="6">
            <Label text="Описание"/>
            <TextArea fx:id="descriptionField" wrapText="true" prefRowCount="3"/>
        </VBox>
    </VBox>
    <Label text="* — обязательные поля. Срок выбирается в календаре." styleClass="subtitle"/>
    <Label fx:id="messageLabel" wrapText="true" styleClass="subtitle"/>
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="cancelButton" text="Отмена" cancelButton="true" onAction="#close"/>
        <Button fx:id="saveButton" text="Сохранить" defaultButton="true" onAction="#save"/>
    </HBox>
</VBox>
